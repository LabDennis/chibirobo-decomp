#ifndef _RVL_MSL_NEW
#define _RVL_MSL_NEW

#include <types.h>
#include <msl/exception>

namespace std {
class bad_alloc : public exception {
public:
	virtual ~bad_alloc() { }
	virtual const char* what() const { return "bad_alloc"; }
};
} // namespace std

inline void* operator new(size_t, void* ptr) { return ptr; }
inline void* operator new[](size_t, void* ptr) { return ptr; }

#endif
