// C++ face of the Wii MSL math header: what NW4R reaches through std::
#ifndef _RVL_MSL_CMATH
#define _RVL_MSL_CMATH

#include <math.h>

extern "C" double modf(double, double*);

// the float versions are MSL's inline wrappers around the double routines
inline float ceilf(float x) { return ceil(x); }
inline float floorf(float x) { return floor(x); }
inline float ldexpf(float x, int exp) { return ldexp(x, exp); }
inline float fmodf(float x, float y) { return fmod(x, y); }
inline float modff(float x, float* iptr)
{
	double i;
	float frac = modf(x, &i);
	*iptr      = i;
	return frac;
}

namespace std {
using ::acos;
using ::asin;
using ::ceilf;
using ::floorf;
using ::fmodf;
using ::modff;
using ::ldexpf;
// include/stl/math.h declares the GameCube MSL's out-of-line tanf; the Wii MSL's is this wrapper (retail calls tan)
inline float tanf(float x) { return tan(x); }
} // namespace std

// nw4r::snd (Sound3DCalculator): retail rounds each result to float (frsp behind `bl cos`)
namespace std {
inline float cos(float x) { return ::cos(x); }
using ::pow;
} // namespace std

// nw4r::ef: the Wii MSL's float wrappers around the double routines (retail calls sin, cos, atan2, asin)
namespace std {
inline float sinf(float x) { return ::sin(x); }
inline float cosf(float x) { return ::cos(x); }
inline float asinf(float x) { return ::asin(x); }
inline float atan2f(float y, float x) { return ::atan2(y, x); }
// MSL's inline fabsf: a double fabs cast back to float (fabs + frsp in retail, e.g. 0x80247E24)
inline float fabsf(float x) { return static_cast<float>(fabsl(x)); }
} // namespace std

#endif
